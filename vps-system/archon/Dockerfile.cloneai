FROM node:18-alpine

# Install Python for AI bridge
RUN apk add --no-cache python3 py3-pip

WORKDIR /app

# Copy package files
COPY clone-ai-bridge/package*.json ./

# Install dependencies
RUN npm ci

# Copy bridge code
COPY clone-ai-bridge/ .

# Expose port
EXPOSE 8054

# Start the bridge
CMD ["node", "index.js"]