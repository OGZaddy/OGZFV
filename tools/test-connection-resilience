// test-connection-resilience.js
const OGZPrimeV10 = require('./OGZPrimeV10.2');

async function testConnectionResilience() {
  console.log('🧪 CONNECTION RESILIENCE TEST SUITE');
  console.log('==================================\n');
  
  // Initialize bot
  const bot = new OGZPrimeV10({
    mode: 'simulate',
    initialBalance: 10000
  });
  
  bot.start();
  
  // Test 1: Normal operation
  console.log('Test 1: Verify normal operation');
  await new Promise(r => setTimeout(r, 5000));
  console.log('✅ Bot running normally\n');
  
  // Test 2: Simulate connection loss
  console.log('Test 2: Simulating connection loss...');
  
  // Stop the simulation to trigger stale data
  clearInterval(bot.simulationInterval);
  bot.simulationInterval = null;
  
  console.log('⏳ Waiting for automatic reconnection...');
  
  // Wait and observe
  await new Promise(r => setTimeout(r, 45000)); // 45 seconds
  
  // Check if reconnected
  if (bot.simulationInterval) {
    console.log('✅ Connection automatically restored!\n');
  } else {
    console.log('❌ Reconnection failed\n');
  }
  
  // Test 3: Connection loss with position
  console.log('Test 3: Connection loss with open position');
  
  // Open a position
  bot.executeManualBuy();
  await new Promise(r => setTimeout(r, 2000));
  
  // Kill connection again
  clearInterval(bot.simulationInterval);
  bot.simulationInterval = null;
  
  console.log('⏳ Position active during disconnection...');
  await new Promise(r => setTimeout(r, 35000));
  
  // Check position integrity
  if (bot.tradingBrain.isInPosition()) {
    console.log('✅ Position preserved through disconnection');
    console.log(`   Stop loss: $${bot.tradingBrain.maxProfitManager.state.currentStop?.toFixed(2)}`);
  }
  
  // Clean shutdown
  bot.shutdown();
  
  console.log('\n✅ Connection Resilience Test Complete!');
}

// Run the test
testConnectionResilience().catch(console.error);