# Trading Bot Dockerfile
FROM node:18-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci --only=production

# Copy bot application code
COPY run-trading-bot-v13-ogzprime-multitenant.js ./

# Create necessary directories
RUN mkdir -p logs reports config

# Run as non-root user
RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001
USER nodejs

CMD ["node", "run-trading-bot-v13-ogzprime-multitenant.js"]