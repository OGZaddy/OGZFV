# OGZ Prime Environment Template (.env.example)
# Copy to .env and fill in required values. Do NOT commit your real .env.

# Core
NODE_ENV=production
LOG_LEVEL=info
LOG_DIRECTORY=./logs

# WebSocket Hub
PORT=3008
WS_PORT=3010
WS_HOST=127.0.0.1
USE_SSL=false
ENABLE_PRICE_BROADCAST=false

# Domains
WEBSOCKET_DOMAIN=ogzprime.com
SITE_URL=https://ogzprime.com

# Polygon.io
POLYGON_API_KEY=YOUR_POLYGON_KEY

# Stripe
STRIPE_SECRET_KEY=sk_live_your_key_here

# Security
JWT_SECRET=change_me_to_a_long_random_string

# TRAI / LLM
SSL_SERVER_URL=wss://ogzprime.com/ws
OLLAMA_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2:7b

# Trading defaults
PRIMARY_ASSET=BTC-USD
STARTING_BALANCE=10000
MAX_DRAWDOWN=18
RISK_PER_TRADE=1.5
MIN_TRADE_CONFIDENCE=0.45
PATTERN_CONFIDENCE=0.35
EMERGENCY_CONFIDENCE=0.25
MAX_POSITION_SIZE=0.05
STOP_LOSS_PERCENT=4.0
TAKE_PROFIT_PERCENT=8.0
TRAILING_STOP_PERCENT=3.0
MAX_DAILY_LOSS=10.0
TRADE_INTERVAL=30000
PATTERN_UPDATE=15000
RISK_CHECK=10000

# Database (optional)
DATABASE_URL=postgresql://user:password@localhost/ogzprime_prod
REDIS_URL=redis://localhost:6379

# Supabase (optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=service_key_here
SUPABASE_ANON_KEY=anon_key_here

# Third-party APIs (optional)
GOOGLE_API_KEY=
GEMINI_API_KEY=

# PM2/Processes (optional)
OGZ_SSL_SERVER=true

