# Dashboard Server Dockerfile
FROM node:18-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci --only=production

# Copy dashboard server code
COPY dashboard-bridge.js ./

# Copy public files
COPY public/ ./public/

# Create necessary directories
RUN mkdir -p logs

# Run as non-root user
RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001
USER nodejs

EXPOSE 3333

CMD ["node", "dashboard-bridge.js"]