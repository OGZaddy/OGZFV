# OGZ Prime Docker Environment Configuration

# Database
DB_PASSWORD=OGZPrime2024!Secure

# API Keys
POLYGON_API_KEY=YOUR_POLYGON_KEY_HERE

# Ollama Configuration
# Use remote Ollama if available, otherwise local container
OLLAMA_URL=http://ollama:11434

# Node Environment
NODE_ENV=production

# Ports (customize if needed)
SSL_PORT=3010
DASHBOARD_PORT=3333
OLLAMA_PORT=11434
REDIS_PORT=6379
POSTGRES_PORT=5432

# Resource Limits
OLLAMA_MEMORY_LIMIT=8G
BOT_MEMORY_LIMIT=2G
SSL_MEMORY_LIMIT=1G

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# SSL/TLS
SSL_CERT_PATH=/etc/letsencrypt/live/ogzprime.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/ogzprime.com/privkey.pem