{
  "name": "ogz-prime-valhalla-edition",
  "version": "13.0.0",
  "description": "AI-Powered Trading Operating System - Simplified Production Ready Version",
  "main": "run-trading-bot-v13-simplified.js",
  "scripts": {
    "start": "node run-trading-bot-v13-simplified.js",
    "bot": "node run-trading-bot-v13-simplified.js --profile default --asset BTC-USD",
    "dashboard": "node ogzprime_ssl_server_advanced.js",
    "trai": "node trai-singleton.js",
    "trai:voice": "node trai-voice-server.js",
    "backtest:trai": "node backtest-v13-with-trai.js",
    "backtest:quick": "node backtest-v13-with-trai.js --quick",
    "backtest": "node tools/optimized-backtester.js",
    "launch": "node launch-turbo-train.bat",
    "safety": "node CRITICAL_SAFETY.js",
    "debug": "node enhanced-safety-diagnostics.js",
    "backtest:btc": "node quick-backtest.js",
    "backtest:simple": "node backtest-production-simple.js",
    "paper:start": "node paper-trading-controller.js",
    "paper:24h": "PAPER_BALANCE=10000 MAX_DAILY_LOSS=100 node paper-trading-controller.js",
    "build:kb": "node scripts/build-knowledge-index.js",
    "smoke:security": "node scripts/security-smoke-check.js",
    "aggregate:insights": "node scripts/aggregate-insights.js",
    "profile:backtest": "node tools/run-profile-backtest.js --profile profiles/elite-btc.json",
    "profile:backtest:eth": "node tools/run-profile-backtest.js --profile profiles/elite-eth.json",
    "profile:backtest:sol": "node tools/run-profile-backtest.js --profile profiles/elite-sol.json",
    "sweep:btc": "node tools/sweep-profiles.js --base profiles/elite-btc.json --grid \"minTradeConfidence=0,0.1;patternConfidence=0.2,0.25,0.3;fallbackPatternConfidence=0.2,0.25;stopLossPercent=4,5;takeProfitPercent=8,10,12\" --top 10",
    "sweep:eth": "node tools/sweep-profiles.js --base profiles/elite-eth.json --grid \"minTradeConfidence=0,0.1;patternConfidence=0.2,0.25,0.3;fallbackPatternConfidence=0.2,0.25;stopLossPercent=4,5;takeProfitPercent=8,10,12\" --top 10",
    "sweep:sol": "node tools/sweep-profiles.js --base profiles/elite-sol.json --grid \"minTradeConfidence=0,0.1;patternConfidence=0.2,0.25,0.3;fallbackPatternConfidence=0.2,0.25;stopLossPercent=4,5;takeProfitPercent=8,10,12\" --top 10",
    "paper:test": "PAPER_BALANCE=1000 MAX_DAILY_LOSS=50 node paper-trading-controller.js",
    "live:100": "LIVE_MODE=true INITIAL_BALANCE=100 MAX_RISK=0.02 node run-trading-bot-v13-simplified.js",
    "live:start": "LIVE_MODE=true node run-trading-bot-v13-simplified.js",
    "live:halt": "echo '{\"type\":\"halt\"}' | curl -X POST http://localhost:9999",
    "live:resume": "echo '{\"type\":\"resume\"}' | curl -X POST http://localhost:9999",
    "gp:enrich": "node live_vs_backtest.js",
    "gp:metrics": "node metrics_rollup.js",
    "gp:watch": "watch -n 10 'node metrics_rollup.js'",
    "live:track": "node live_vs_backtest.js && node metrics_rollup.js",
    "stats:verify": "node -e \"require('./trai-stats-integration').verifyBrainConnection().then(console.log)\"",
    "stats:history": "tail -n 10 stats-history.jsonl",
    "kill:all": "pkill -SIGUSR1 -f 'node.*trading'",
    "kill:emergency": "pkill -9 -f 'node.*trading' && echo 'EMERGENCY KILL EXECUTED'",
    "test:before-live": "npm run backtest:simple && npm run paper:test",
    "report:stats": "cat TRADING_BOT_STATS.md",
    "report:paper": "tail -f paper-trades.jsonl",
    "report:live": "tail -f live-trades.jsonl"
  },
  "keywords": [
    "trading",
    "bot",
    "ai",
    "cryptocurrency",
    "algorithmic-trading",
    "pattern-recognition",
    "risk-management",
    "real-time",
    "modular",
    "local-deployment"
  ],
  "author": "OGZaddy <epb1777@gmail.com>",
  "license": "PROPRIETARY",
  "repository": {
    "type": "git",
    "url": "https://github.com/OGZaddy/OGZPrimeValhallaEdition.git"
  },
  "bugs": {
    "url": "https://github.com/OGZaddy/OGZPrimeValhallaEdition/issues"
  },
  "homepage": "https://github.com/OGZaddy/OGZPrimeValhallaEdition#readme",
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "axios": "^1.10.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.0",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^3.0.0",
    "qrcode": "^1.5.4",
    "require-in-the-middle": "^7.5.2",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "stripe": "^18.5.0",
    "ws": "^8.0.0"
  },
  "private": false
}
